NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Used to build links in emails (password reset)
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug
# Set true when running behind nginx / a load balancer (correct client IPs for rate limits)
TRUST_PROXY=false

# PostgreSQL on the host machine (no Postgres container). Schema changes go
# through Prisma migrations: `npm run db:migrate` (dev), `npm run db:deploy` (prod).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:password@localhost:5432/webbuilder?schema=public

# Redis on the host machine (OTP codes, reset tokens, login lockout, rate limits)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=webbuilder:

# JWT secrets: at least 32 random characters each, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth cookies. COOKIE_SECURE defaults to true when NODE_ENV=production.
# Use COOKIE_SAMESITE=none (+ secure) only if frontend and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Encrypts secrets stored in the DB (Resend API key). At least 32 characters.
# Changing it makes stored secrets unreadable; re-enter them in Super Admin settings.
APP_ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars

# Media storage: Linode Object Storage (S3-compatible). The bucket stays private;
# files are served through the API. Leave blank to store files under ./uploads.
# Endpoint example: https://ap-south-1.linodeobjects.com
LINODE_OBJECT_STORAGE_ENDPOINT=
LINODE_OBJECT_STORAGE_REGION=ap-south-1
LINODE_OBJECT_STORAGE_BUCKET=
LINODE_OBJECT_STORAGE_ACCESS_KEY=
LINODE_OBJECT_STORAGE_SECRET_KEY=
# Optional prefix inside the bucket. Empty = bucket root.
STORAGE_FOLDER=webbuilder
UPLOAD_LOCAL_DIR=uploads
# Public URL of this API; media URLs saved in website content start with it.
API_PUBLIC_URL=http://localhost:3000

# Super Admin account created on first start (only if the email doesn't exist yet).
# Use a strong password in production.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_SUPER_ADMIN_NAME=Super Admin

# Published websites. See deploy/nginx-domain-sync/README.md.
# Free addresses are <subdomain>.PUBLIC_SITE_DOMAIN (needs a wildcard DNS record to this server).
PUBLIC_SITE_DOMAIN=bytezora.site
# Internal site-renderer service (frontend repo, `docker compose up site-renderer`).
SITE_RENDERER_URL=http://127.0.0.1:3100
# Where customers point their domains. Domains are verified against these, and the
# DNS instructions shown to customers use them. Comma-separated public IPv4/IPv6.
SITE_SERVER_IPS=
# Optional hostname customers can CNAME sub-domains (www.) to, e.g. sites.yourplatform.com
SITE_CNAME_TARGET=
# Lets the server's nginx sync script read connected domains. `openssl rand -hex 32`; empty = off.
DOMAIN_SYNC_TOKEN=

