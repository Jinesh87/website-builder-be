/// A client website. `theme`, `header` and `footer` hold the editable DRAFT
/// (site-kit JSON); visitors only ever see the snapshot in `liveVersion`.
model Website {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @db.Uuid
  name        String        @db.VarChar(120)
  builderType BuilderType
  status      WebsiteStatus @default(DRAFT)
  /// Default address: <subdomain>.<platform domain>. Lowercase DNS label.
  subdomain   String        @unique @db.VarChar(63)

  businessName String? @db.VarChar(160)
  websiteType  String? @db.VarChar(80)
  industry     String? @db.VarChar(80)
  description  String? @db.VarChar(2000)
  contactEmail String? @db.VarChar(255)
  contactPhone String? @db.VarChar(32)
  address      String? @db.VarChar(500)
  logoMediaId  String? @db.Uuid

  theme  Json
  header Json
  footer Json

  /// Bumped on every draft change; "unpublished changes" = draftUpdatedAt > publishedAt.
  draftUpdatedAt DateTime  @default(now()) @db.Timestamptz(6)
  liveVersionId  String?   @unique @db.Uuid
  publishedAt    DateTime? @db.Timestamptz(6)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User?              @relation("WebsiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  logo           MediaFile?         @relation("WebsiteLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  liveVersion    WebsiteVersion?    @relation("WebsiteLiveVersion", fields: [liveVersionId], references: [id], onDelete: SetNull)
  versions       WebsiteVersion[]   @relation("WebsiteVersions")
  pages          Page[]
  domains        Domain[]
  media          MediaFile[]        @relation("WebsiteMedia")
  mediaFolders   MediaFolder[]
  aiUsageLogs    AiUsageLog[]
  aiChatSessions AiChatSession[]
  generation     WebsiteGeneration?

  /// Target for (websiteId, clientId) foreign keys, which guarantee child rows
  /// can never point at a website owned by a different client.
  @@unique([id, clientId])
  @@index([clientId, updatedAt])
  @@index([status])
  @@map("websites")
}
