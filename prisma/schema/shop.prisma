/// A product group on one website's shop. Names are unique per website, ignoring case.
model ShopCategory {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  clientId  String   @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  website  Website   @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)
  products Product[]

  @@unique([websiteId, slug])
  @@unique([id, websiteId])
  @@index([clientId])
  @@map("shop_categories")
}

/// A sellable item. Each one belongs to a category and has at least one priced variant.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  clientId    String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String   @db.VarChar(160)
  slug        String   @db.VarChar(160)
  description String?  @db.VarChar(2000)
  /// How the client configured options (size, colour, …) and which values share a price.
  optionSets  Json     @default("[]")
  /// Product photos, in display order. Each item is `{ mediaId, alt }`.
  images      Json     @default("[]")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  website   Website             @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)
  category  ShopCategory        @relation(fields: [categoryId, websiteId], references: [id, websiteId], onDelete: Restrict)
  variants  ProductVariant[]
  movements InventoryMovement[]
  cartItems ShopCartItem[]

  @@unique([websiteId, slug])
  @@index([websiteId, categoryId])
  @@index([clientId])
  @@map("products")
}

/// One purchasable option of a product. Price is stored in paise.
model ProductVariant {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  name       String  @db.VarChar(160)
  sku        String? @db.VarChar(64)
  pricePaise Int
  sortOrder  Int     @default(0)
  /// Photos for this variant, in display order. Each item is `{ mediaId, alt }`.
  images     Json    @default("[]")
  /// Units on hand. Carried across product edits when the variant name stays the same.
  quantity   Int     @default(0)

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]
  cartItems  ShopCartItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

/// Razorpay account for this website's shop. Secrets are AES-256-GCM encrypted.
/// The webhook lives on the platform API; the site URL is what Razorpay reviews.
model ShopPaymentConfig {
  websiteId                   String   @id @db.Uuid
  clientId                    String   @db.Uuid
  razorpayKeyId               String?  @db.VarChar(100)
  razorpayKeySecretCipher     String?  @db.Text
  razorpayWebhookSecretCipher String?  @db.Text
  createdAt                   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)

  @@unique([websiteId, clientId])
  @@index([clientId])
  @@map("shop_payment_configs")
}

/// One stock change. Names are copied so the row still reads after the variant is edited or removed.
model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  websiteId     String   @db.Uuid
  clientId      String   @db.Uuid
  productId     String?  @db.Uuid
  variantId     String?  @db.Uuid
  productName   String   @db.VarChar(160)
  variantName   String   @db.VarChar(160)
  delta         Int
  quantityAfter Int
  note          String?  @db.VarChar(300)
  userId        String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  website Website         @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([websiteId, createdAt])
  @@index([clientId])
  @@map("inventory_movements")
}

/// A buyer account on one website's shop. Email is unique per website, not globally.
model ShopCustomer {
  id              String     @id @default(uuid()) @db.Uuid
  websiteId       String     @db.Uuid
  clientId        String     @db.Uuid
  email           String     @db.VarChar(255)
  passwordHash    String     @db.VarChar(255)
  fullName        String     @db.VarChar(120)
  phone           String?    @db.VarChar(32)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  lastSignedInAt  DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  website       Website                    @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)
  refreshTokens ShopCustomerRefreshToken[]
  cartItems     ShopCartItem[]

  @@unique([websiteId, email])
  @@index([websiteId, status])
  @@index([clientId])
  @@map("shop_customers")
}

/// One line in a signed-in shopper's cart. Unique per customer + variant.
model ShopCartItem {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  clientId   String   @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  variantId  String   @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  website  Website        @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)
  customer ShopCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, variantId])
  @@index([websiteId, customerId])
  @@index([clientId])
  @@map("shop_cart_items")
}

model ShopCustomerRefreshToken {
  id         String    @id @db.Uuid
  customerId String    @db.Uuid
  /// SHA-256 of the raw token; the raw token only lives in the httpOnly cookie.
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  customer ShopCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("shop_customer_refresh_tokens")
}
