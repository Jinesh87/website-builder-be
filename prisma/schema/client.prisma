/// Client workspace. Every client-owned record (websites, pages, media, settings) carries a clientId.
model Client {
  id           String       @id @default(uuid()) @db.Uuid
  businessName String       @db.VarChar(160)
  address      String?      @db.VarChar(500)
  source       ClientSource
  /// When false, client users can edit but only a Super Admin can publish.
  canPublish   Boolean      @default(true)
  /// AI model chosen by the client; null = use the platform default from AiConfig.
  aiModel      String?      @db.VarChar(100)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  users         User[]
  websites      Website[]
  mediaFolders  MediaFolder[]
  mediaFiles    MediaFile[]
  savedSections SavedSection[]
  templates     WebsiteTemplate[]
  aiUsageLogs   AiUsageLog[]
  wallet        Wallet?
  paymentOrders PaymentOrder[]

  @@map("clients")
}
