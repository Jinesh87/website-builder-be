model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Null only for admin-created clients that log in with a username.
  email           String?    @unique @db.VarChar(255)
  /// Set only when a Super Admin issues the login credentials; stored lowercase.
  username        String?    @unique @db.VarChar(40)
  passwordHash    String     @db.VarChar(255)
  fullName        String     @db.VarChar(120)
  phone           String?    @db.VarChar(32)
  role            UserRole
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  lastSignedInAt  DateTime?  @db.Timestamptz(6)
  /// Null for SUPER_ADMIN; required for CLIENT users.
  clientId        String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  client        Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  websitesCreated      Website[]                @relation("WebsiteCreatedBy")
  versionsPublished    WebsiteVersion[]         @relation("VersionPublishedBy")
  mediaUploaded        MediaFile[]              @relation("MediaUploadedBy")
  savedSectionsCreated SavedSection[]           @relation("SavedSectionCreatedBy")
  templatesCreated     WebsiteTemplate[]        @relation("WebsiteTemplateCreatedBy")
  templatesUpdated     WebsiteTemplate[]        @relation("WebsiteTemplateUpdatedBy")
  aiUsageLogs          AiUsageLog[]
  generationsRequested WebsiteGeneration[]      @relation("WebsiteGenerationRequestedBy")
  walletTransactions   WalletTransaction[]      @relation("WalletTransactionUser")
  paymentOrders        PaymentOrder[]           @relation("PaymentOrderUser")
  hostingSubscriptions HostingSubscription[]    @relation("HostingSubscriptionCreatedBy")
  hostingPayments      HostingPayment[]         @relation("HostingPaymentRecordedBy")
  hostingPriceChanges  HostingPriceChange[]     @relation("HostingPriceChangedBy")
  hostingOrders        HostingOrder[]           @relation("HostingOrderUser")
  hostingAutopays      HostingAutopay[]         @relation("HostingAutopayUser")
  walletAutoTopups     WalletAutoTopup[]        @relation("WalletAutoTopupUser")
  inventoryMovements   InventoryMovement[]
  enquiryActivity      ContactInquiryActivity[] @relation("ContactInquiryActivityActor")

  @@index([clientId])
  @@index([role, status])
  @@map("users")
}
