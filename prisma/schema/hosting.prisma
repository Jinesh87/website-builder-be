/// Singleton (id = "default"): platform-wide hosting billing rules, managed by the Super Admin. Prices live on the packages.
model HostingConfig {
  id                   String   @id @default("default") @db.VarChar(50)
  /// Off: publishing needs no plan and the billing worker does nothing.
  enabled              Boolean  @default(false)
  /// Clients may also pay hosting from their connects; Razorpay is always the default.
  allowConnectsPayment Boolean  @default(true)
  /// Days before a period ends that the renewal reminder goes out.
  reminderDays         Int      @default(3)
  /// Days an unpaid site stays live after its period ends.
  graceDays            Int      @default(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  @@map("hosting_config")
}

/// A package on the pricing page and at checkout. The set is fixed (basic = Starter, standard = Dedicated, custom); the Super Admin edits them.
model HostingPackage {
  id                     String   @id @default(uuid()) @db.Uuid
  slug                   String   @unique @db.VarChar(40)
  name                   String   @db.VarChar(60)
  description            String   @db.VarChar(300)
  /// Priced per website: a website's own custom price, else the package's default price.
  isCustom               Boolean  @default(false)
  /// Listed packages only. Paise per period; 0 = not priced yet, so it can't be bought.
  quarterlyPricePaise    Int      @default(0)
  yearlyPricePaise       Int      @default(0)
  /// Custom package only: paise per period for a website without its own price; 0 = none, so such a website can't buy it.
  defaultQuarterlyPaise  Int      @default(0)
  defaultYearlyPaise     Int      @default(0)
  features               String[]
  /// Highlighted as the recommended package; at most one.
  featured               Boolean  @default(false)
  /// Hidden from the pricing page and checkout when false; existing plans keep it.
  active                 Boolean  @default(true)
  /// Automatic website backup cadence in days for websites on this package. Null = no scheduled backups.
  websiteBackupDays      Int?
  /// Media library quota in mebibytes for clients on this package. Shared across their websites; the highest active plan wins.
  mediaStorageMb         Int      @default(1024)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  subscriptions HostingSubscription[]
  orders        HostingOrder[]
  autopays      HostingAutopay[]

  @@map("hosting_packages")
}

/// Hosting plan of one website. Each website renews on its own dates.
model HostingSubscription {
  id                   String        @id @default(uuid()) @db.Uuid
  websiteId            String        @unique @db.Uuid
  clientId             String        @db.Uuid
  /// Package and cycle apply from the next payment; changing them never alters the current period.
  packageId            String?       @db.Uuid
  cycle                BillingCycle
  /// This website's price on the custom package, in paise per period; null = the package's default. 0 = free.
  /// Filled in when a custom plan is paid, so a later change to the default doesn't reprice it.
  customQuarterlyPaise Int?
  customYearlyPaise    Int?
  /// This website's feature list on the custom package (JSON string[]). Null = package default features.
  customFeatures       Json?
  status               HostingStatus @default(AWAITING_PAYMENT)
  /// Renew from the client's connects when the period ends (only while connects payments are allowed).
  /// Never on together with a live autopay, so a period is not charged twice.
  autoRenew            Boolean       @default(false)
  /// True while the current ACTIVE period was granted free (admin grant / bulk backfill), not paid.
  isComplimentary      Boolean       @default(false)
  /// Per-website grace after expiry. Null = platform HostingConfig.graceDays.
  graceDaysOverride    Int?
  currentPeriodStart   DateTime?     @db.Timestamptz(6)
  currentPeriodEnd     DateTime?     @db.Timestamptz(6)
  /// Set while in GRACE: the site goes offline at this time unless paid.
  graceEndsAt          DateTime?     @db.Timestamptz(6)
  suspendedAt          DateTime?     @db.Timestamptz(6)
  createdById          String?       @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  website   Website          @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Cascade)
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package   HostingPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("HostingSubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments  HostingPayment[]
  notices   HostingNotice[]
  autopay   HostingAutopay?

  /// Required by the (websiteId, clientId) foreign key, which keeps clientId equal to the website's client.
  @@unique([websiteId, clientId])
  @@index([status, currentPeriodEnd])
  @@index([status, graceEndsAt])
  @@index([clientId])
  @@index([packageId])
  @@map("hosting_subscriptions")
}

/// A Razorpay order for one hosting period. Package, cycle and price are fixed when it is created.
model HostingOrder {
  id                     String             @id @default(uuid()) @db.Uuid
  clientId               String             @db.Uuid
  websiteId              String?            @db.Uuid
  userId                 String?            @db.Uuid
  packageId              String?            @db.Uuid
  packageName            String             @db.VarChar(60)
  cycle                  BillingCycle
  amountPaise            Int
  currency               String             @default("INR") @db.VarChar(3)
  /// Coupon applied at checkout; amountPaise is the discounted total charged to Razorpay.
  couponId               String?            @db.Uuid
  /// List price before discount; null when no coupon was used.
  listAmountPaise        Int?
  discountPaise          Int?
  razorpayOrderId        String             @unique @db.VarChar(64)
  razorpayPaymentId      String?            @unique @db.VarChar(64)
  /// PAID only once the period is recorded; a captured payment that couldn't be applied stays CREATED with a reason.
  status                 PaymentOrderStatus @default(CREATED)
  failureReason          String?            @db.VarChar(500)
  /// Set when autopay charged it rather than a one-off checkout.
  razorpaySubscriptionId String?            @db.VarChar(64)
  paidAt                 DateTime?          @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)

  client      Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  website     Website?                  @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  user        User?                     @relation("HostingOrderUser", fields: [userId], references: [id], onDelete: SetNull)
  package     HostingPackage?           @relation(fields: [packageId], references: [id], onDelete: SetNull)
  coupon      HostingCoupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payment     HostingPayment?
  redemption  HostingCouponRedemption?

  @@index([clientId, createdAt])
  @@index([websiteId, createdAt])
  @@index([couponId])
  @@map("hosting_orders")
}

/// Super Admin coupon for hosting subscription purchases (Razorpay / connects).
model HostingCoupon {
  id            String                   @id @default(uuid()) @db.Uuid
  /// Stored uppercase; clients enter case-insensitively.
  code          String                   @unique @db.VarChar(40)
  discountType  HostingCouponDiscountType
  /// PERCENT: 1–100. FIXED_PAISE: discount in paise.
  discountValue Int
  expiresAt     DateTime?                @db.Timestamptz(6)
  /// Null = unlimited redemptions.
  maxUses       Int?
  usedCount     Int                      @default(0)
  active        Boolean                  @default(true)
  createdById   String?                  @db.Uuid
  createdAt     DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(6)

  createdBy   User?                     @relation("HostingCouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orders      HostingOrder[]
  redemptions HostingCouponRedemption[]

  @@index([active, expiresAt])
  @@map("hosting_coupons")
}

/// One successful use of a coupon by a client (once per client per coupon).
model HostingCouponRedemption {
  id               String   @id @default(uuid()) @db.Uuid
  couponId         String   @db.Uuid
  clientId         String   @db.Uuid
  userId           String?  @db.Uuid
  websiteId        String?  @db.Uuid
  hostingOrderId   String?  @unique @db.Uuid
  hostingPaymentId String?  @unique @db.Uuid
  listAmountPaise  Int
  discountPaise    Int
  finalAmountPaise Int
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  coupon         HostingCoupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user           User?           @relation("HostingCouponRedeemedBy", fields: [userId], references: [id], onDelete: SetNull)
  website        Website?        @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  hostingOrder   HostingOrder?   @relation(fields: [hostingOrderId], references: [id], onDelete: SetNull)
  hostingPayment HostingPayment? @relation(fields: [hostingPaymentId], references: [id], onDelete: SetNull)

  @@unique([couponId, clientId])
  @@index([couponId, createdAt])
  @@index([clientId, createdAt])
  @@map("hosting_coupon_redemptions")
}

/// Razorpay autopay for one website's hosting: a subscription that charges the plan's price every period on the
/// client's card or UPI mandate. Package, cycle and price are fixed when the client approves it; a plan or price
/// change cancels it, so a charge never applies a plan the client didn't approve.
model HostingAutopay {
  id                     String        @id @default(uuid()) @db.Uuid
  subscriptionId         String        @unique @db.Uuid
  clientId               String        @db.Uuid
  userId                 String?       @db.Uuid
  razorpaySubscriptionId String        @unique @db.VarChar(64)
  packageId              String?       @db.Uuid
  packageName            String        @db.VarChar(60)
  cycle                  BillingCycle
  amountPaise            Int
  status                 AutopayStatus @default(CREATED)
  /// First charge: the end of the paid period. Null = charged as soon as the client approves.
  startAt                DateTime?     @db.Timestamptz(6)
  /// When Razorpay charges next, as last reported by Razorpay.
  nextChargeAt           DateTime?     @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)

  subscription HostingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User?               @relation("HostingAutopayUser", fields: [userId], references: [id], onDelete: SetNull)
  package      HostingPackage?     @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([packageId])
  @@map("hosting_autopays")
}

/// One paid hosting period. Kept when the website is deleted, for the report.
model HostingPayment {
  id                  String               @id @default(uuid()) @db.Uuid
  subscriptionId      String?              @db.Uuid
  clientId            String               @db.Uuid
  websiteId           String?              @db.Uuid
  /// Snapshots, so the report still reads well after a rename or deletion.
  websiteName         String               @db.VarChar(120)
  packageName         String?              @db.VarChar(60)
  cycle               BillingCycle
  /// Price of the period in paise, however it was paid.
  amountPaise         Int
  /// Connects charged from the wallet; null when paid by Razorpay or collected offline.
  connects            Int?
  periodStart         DateTime             @db.Timestamptz(6)
  periodEnd           DateTime             @db.Timestamptz(6)
  paidBy              HostingPayer
  method              HostingPaymentMethod
  /// Money the admin collected offline, in paise. Null otherwise.
  collectedPaise      Int?
  reference           String?              @db.VarChar(120)
  note                String?              @db.VarChar(500)
  walletTransactionId String?              @unique @db.Uuid
  hostingOrderId      String?              @unique @db.Uuid
  recordedById        String?              @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)

  subscription      HostingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  walletTransaction WalletTransaction?       @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  hostingOrder      HostingOrder?            @relation(fields: [hostingOrderId], references: [id], onDelete: SetNull)
  recordedBy        User?                    @relation("HostingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  couponRedemption  HostingCouponRedemption?

  /// A period can be paid once, however many people (or the worker) try at the same time.
  @@unique([subscriptionId, periodStart])
  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("hosting_payments")
}

/// Billing emails already sent, so each goes out once per period.
model HostingNotice {
  id             String            @id @default(uuid()) @db.Uuid
  subscriptionId String            @db.Uuid
  kind           HostingNoticeKind
  periodEnd      DateTime          @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  subscription HostingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, kind, periodEnd])
  @@map("hosting_notices")
}

/// Audit log of hosting price changes.
model HostingPriceChange {
  id                String            @id @default(uuid()) @db.Uuid
  scope             HostingPriceScope
  clientId          String?           @db.Uuid
  websiteId         String?           @db.Uuid
  /// Name of the package, client or website at the time of the change.
  label             String            @db.VarChar(160)
  /// Changes made before hosting moved to rupees are in connects.
  unit              HostingPriceUnit  @default(PAISE)
  oldQuarterlyPrice Int?
  newQuarterlyPrice Int?
  oldYearlyPrice    Int?
  newYearlyPrice    Int?
  changedById       String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)

  changedBy User? @relation("HostingPriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@map("hosting_price_changes")
}

enum BillingCycle {
  QUARTERLY
  YEARLY
}

enum HostingStatus {
  /// Plan set up, first period not paid yet. The site can't be published.
  AWAITING_PAYMENT
  ACTIVE
  /// Period ended unpaid; the site stays live until graceEndsAt.
  GRACE
  /// Grace ended unpaid; the site was taken offline.
  SUSPENDED
}

enum HostingPayer {
  CLIENT
  ADMIN
  /// Auto-renewal by the billing worker.
  SYSTEM
}

enum HostingPaymentMethod {
  WALLET
  CASH
  UPI
  BANK_TRANSFER
  RAZORPAY
}

enum HostingNoticeKind {
  RENEWAL_REMINDER
  EXPIRED
  SUSPENDED
}

/// Client-facing hosting email the Super Admin can customize (subject / heading / message).
enum HostingEmailKind {
  RENEWAL_REMINDER
  PAID
  EXPIRED
  SUSPENDED
  AUTOPAY_STOPPED
}

/// Platform-wide hosting notice email copy. Missing rows fall back to code defaults.
model HostingEmailTemplate {
  id        String          @id @default(uuid()) @db.Uuid
  kind      HostingEmailKind @unique
  enabled   Boolean         @default(true)
  subject   String          @db.VarChar(200)
  heading   String          @db.VarChar(160)
  message   String          @db.Text
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)

  @@map("hosting_email_templates")
}

enum HostingPriceScope {
  GLOBAL
  /// Legacy: client-level prices were folded into website prices.
  CLIENT
  WEBSITE
  PACKAGE
}

enum HostingPriceUnit {
  CONNECTS
  PAISE
}

enum HostingCouponDiscountType {
  PERCENT
  FIXED_PAISE
}
