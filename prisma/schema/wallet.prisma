/// One prepaid balance of connects per client, shared by its users. Connects are bought through Razorpay.
model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @unique @db.Uuid
  /// In connects, to a thousandth. AI usage is charged after the request, so it can dip below zero.
  balance   Decimal  @default(0) @db.Decimal(14, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Append-only ledger; every balance change has exactly one row.
model WalletTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  walletId       String                  @db.Uuid
  type           WalletTransactionType
  source         WalletTransactionSource
  /// Connects; always positive, `type` says which way it moved.
  amount         Decimal                 @db.Decimal(14, 3)
  balanceAfter   Decimal                 @db.Decimal(14, 3)
  description    String                  @db.VarChar(300)
  paymentOrderId String?                 @unique @db.Uuid
  userId         String?                 @db.Uuid
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)

  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentOrder   PaymentOrder?   @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  user           User?           @relation("WalletTransactionUser", fields: [userId], references: [id], onDelete: SetNull)
  hostingPayment HostingPayment?

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

/// A Razorpay order created for a purchase of connects.
model PaymentOrder {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String             @db.Uuid
  userId            String?            @db.Uuid
  razorpayOrderId   String             @unique @db.VarChar(64)
  razorpayPaymentId String?            @unique @db.VarChar(64)
  /// Connects credited once paid.
  connects          Int
  amountPaise       Int
  currency          String             @default("INR") @db.VarChar(3)
  status            PaymentOrderStatus @default(CREATED)
  failureReason     String?            @db.VarChar(500)
  /// Set when an auto top-up charged it rather than a one-off checkout.
  razorpaySubscriptionId String?       @db.VarChar(64)
  paidAt            DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User?              @relation("PaymentOrderUser", fields: [userId], references: [id], onDelete: SetNull)
  transaction WalletTransaction?

  @@index([clientId, createdAt])
  @@map("payment_orders")
}

/// A client's auto top-up: a Razorpay subscription that buys the same connects pack every month.
/// One per client; setting it up again replaces the Razorpay subscription.
model WalletAutoTopup {
  id                     String        @id @default(uuid()) @db.Uuid
  clientId               String        @unique @db.Uuid
  userId                 String?       @db.Uuid
  razorpaySubscriptionId String        @unique @db.VarChar(64)
  connects               Int
  amountPaise            Int
  status                 AutopayStatus @default(CREATED)
  /// When Razorpay charges next, as last reported by Razorpay.
  nextChargeAt           DateTime?     @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation("WalletAutoTopupUser", fields: [userId], references: [id], onDelete: SetNull)

  @@map("wallet_auto_topups")
}

/// A Razorpay plan (fixed amount and interval), created once and reused by every subscription on that price.
model RazorpayPlan {
  id             String   @id @default(uuid()) @db.Uuid
  /// Plans belong to a Razorpay account, so test and live keys never share one.
  keyId          String   @db.VarChar(100)
  razorpayPlanId String   @unique @db.VarChar(64)
  /// Razorpay's "monthly" or "yearly".
  period         String   @db.VarChar(10)
  interval       Int
  amountPaise    Int
  currency       String   @db.VarChar(3)
  itemName       String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([keyId, period, interval, amountPaise, currency, itemName])
  @@map("razorpay_plans")
}

/// Singleton (id = "default"), managed by the Super Admin.
model PaymentConfig {
  id                          String   @id @default("default") @db.VarChar(50)
  razorpayKeyId               String?  @db.VarChar(100)
  /// AES-256-GCM encrypted with APP_ENCRYPTION_KEY.
  razorpayKeySecretCipher     String?  @db.Text
  razorpayWebhookSecretCipher String?  @db.Text
  createdAt                   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(6)

  @@map("payment_config")
}

/// Singleton (id = "default"): how AI usage in USD becomes connects.
model BillingConfig {
  id           String   @id @default("default") @db.VarChar(50)
  /// Rupees the Super Admin adds on top of the market USD→INR rate, per US dollar.
  usdInrMargin Decimal  @default(0) @db.Decimal(10, 2)
  /// Connects a client must have before starting an AI request. 0 means any balance above zero.
  minAiBalance Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("billing_config")
}

/// Market USD→INR rate, one row per published rate date.
model ExchangeRate {
  rateDate  DateTime @id @db.Date
  rate      Decimal  @db.Decimal(12, 4)
  /// Which API it came from.
  source    String   @db.VarChar(100)
  fetchedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("exchange_rates")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionSource {
  TOPUP
  AI_USAGE
  ADJUSTMENT
  HOSTING
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

/// A Razorpay subscription's state, mirrored from Razorpay.
enum AutopayStatus {
  /// Waiting for the customer to approve the mandate in Checkout.
  CREATED
  /// Mandate approved; the first charge is scheduled.
  AUTHENTICATED
  ACTIVE
  /// A charge failed and Razorpay is retrying it.
  PENDING
  /// Retries ran out; nothing more is charged.
  HALTED
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}
